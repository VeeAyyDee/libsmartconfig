# SPDX-License-Identifier: 0BSD
menu "Clean-room provisioning example"

choice SC_EXAMPLE_PROTOCOL
    prompt "Provisioning protocol"
    default SC_EXAMPLE_PROTOCOL_V2

config SC_EXAMPLE_PROTOCOL_V2
    bool "ESP-Touch v2"

config SC_EXAMPLE_PROTOCOL_V1
    bool "ESP-Touch v1"

config SC_EXAMPLE_PROTOCOL_AIRKISS
    bool "AirKiss full-message mode"

endchoice

config SC_EXAMPLE_V2_KEY
    string "ESP-Touch v2 AES key (32 hex digits, empty for plaintext)"
    depends on SC_EXAMPLE_PROTOCOL_V2
    default ""
    help
        A nonempty value must contain exactly 32 hexadecimal digits.
        This demonstration embeds the key in sdkconfig and firmware.
        It is not secure key storage. Never use this setting for production
        secrets without a separate key-management design.

config SC_EXAMPLE_AIRKISS_KEY
    string "AirKiss AES key (32 hex digits, empty for plaintext)"
    depends on SC_EXAMPLE_PROTOCOL_AIRKISS
    default ""
    help
        Explicitly selects encrypted-password AirKiss. This UI passes 16 raw
        key bytes; a shorter sender key must be zero-padded in this setting.
        The padded key is also the CBC IV. There is no on-wire mode flag or
        fallback to plaintext. The key is embedded in sdkconfig and firmware;
        this demonstration setting is not secure key storage.

endmenu
